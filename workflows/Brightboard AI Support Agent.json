    {
      "parameters": {
        "jsCode": "const q = $('Telegram Trigger').first().json.callback_query;\nconst [action, ticket_id] = q.data.split(':');\n\nconst full = q.message.text || '';\nconst SEP = '──── DRAFT ────';\nconst idx = full.indexOf(SEP);\nconst separator_found = idx >= 0;\n\n// Only the text after the separator is the customer-facing reply\nconst draft = separator_found ? full.slice(idx + SEP.length).trim() : '';\n\n// The edited Telegram message keeps the full context (header + draft)\nconst full_html = full\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nreturn [{\n  json: {\n    action,\n    ticket_id: Number(ticket_id),\n    draft_reply: draft,\n    draft_html: full_html,\n    separator_found,\n    chat_id: q.message.chat.id,\n    message_id: q.message.message_id\n  }\n}];"
      },
